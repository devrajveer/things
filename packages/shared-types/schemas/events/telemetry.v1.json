{
  "$id": "https://yourplatform.com/schemas/events/telemetry.v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TelemetryEventV1",
  "type": "object",
  "required": ["schema", "event_id", "occurred_at", "ingested_at", "project_id", "device_id", "source", "data"],
  "properties": {
    "schema": { "type": "string", "const": "telemetry.datapoint.v1" },
    "event_id": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "project_id": { "type": "string" },
    "device_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "source": { "type": "string", "enum": ["mqtt", "http", "lora", "internal"] },
    "data": {
      "type": "object",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
